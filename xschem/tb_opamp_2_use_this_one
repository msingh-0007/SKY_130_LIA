N -60 300 -60 330 {lab=Vss}
N -60 240 -10 240 {lab=GND}
N 30 -0 60 0 {lab=Vout}
N -130 -20 -90 -20 {lab=V_plus}
N -120 20 -90 20 {lab=Vout}
N -30 -60 -30 -50 {lab=Vdd}
N -30 50 -30 60 {lab=Vss}
