C {code_shown.sym} 1906.7270333168 -310 0 0 {name=s1 only_toplevel=false value="
.lib /foss/pdks/sky130A/libs.tech/combined/sky130.lib.spice tt
.control
 tran 1u 100m
 
 plot v(v_input) 
 plot v(V_CLK) v(V_Invert)
 plot v(V_Preamp)

 plot (v(V_out1)-v(V_out2))
 *plot v(V_out)
 

 plot (v(V_mix1)-v(V_mix2))
 *plot (v(C_1) - v(C_2))
 *plot v(V_mix1) v(V_out2)
 *noise v(V_out2) Vp dec 10 1 1MEG
 *fourier 1kHz v(V_Preamp) (v(V_mix1)-v(V_out2)) (v(V_out1)-v(V_out2))
 *plot fourier13[1] vs fourier13[0]
 *plot fourier12[1] vs fourier12[0] 
 *plot fourier11[1] vs fourier11[0]   
.endc
.end"}
