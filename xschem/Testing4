* gm/ID Characterization for Sky130 nfet_01v8
* Parameters
.param W_val = 10
.param L_val = 3.0
.dc Vg_p 0 -1.8 -0.01

.save all @m.xm2.msky130_fd_pr__pfet_g5v0d10v5[id]
.save @m.xm2.msky130_fd_pr__pfet_g5v0d10v5[vth]
.save @m.xm2.msky130_fd_pr__pfet_g5v0d10v5[gm]
.save @m.xm2.msky130_fd_pr__pfet_g5v0d10v5[cgg]
.save @m.xm2.msky130_fd_pr__pfet_g5v0d10v5[w]
.save @m.xm2.msky130_fd_pr__pfet_g5v0d10v5[l]
.save @m.xm2.msky130_fd_pr__pfet_g5v0d10v5[gds] 
 

.control
   
  * Direct Plotting in ngspice
  set xbrushwidth=2

 foreach val 6.0 9.0 3.0
  run
  let W_n = @m.xm2.msky130_fd_pr__pfet_g5v0d10v5[w]
  let L_n = @m.xm2.msky130_fd_pr__pfet_g5v0d10v5[l]
  let g_m_n = @m.xm2.msky130_fd_pr__pfet_g5v0d10v5[gm]
  let i_d_n = @m.xm2.msky130_fd_pr__pfet_g5v0d10v5[id]
  let v_th_n = @m.xm2.msky130_fd_pr__pfet_g5v0d10v5[vth]
  let c_gg_n =  @m.xm2.msky130_fd_pr__pfet_g5v0d10v5[cgg]
  let g_ds_n =  @m.xm2.msky130_fd_pr__pfet_g5v0d10v5[gds]


  let gm_id_n = 'g_m_n/i_d_n'
  let v_ov_n = 'abs(v(g_p)) - abs(v_th_n)'
 
  let w_T_n = 'g_m_n/c_gg_n'
  let f_T_n = 'w_T_n/('2*pi')'

  let gm_gmds_n = 'g_m_n/g_ds_n'

  let id_W_n = 'i_d_n/W_n'
 
  alterparam L_val = $val
  reset
 end
  print dc1.L_n dc2.L_n dc3.L_n

  *plot $plot_id_W vs $plot_gm_id ylog xlabel 'Current Eff S/A' ylabel 'A/W' title 'NMOS Id/W vs gm/Id'
  *plot $plot_gm_gmds vs $plot_gm_id xlabel 'Current Eff S/A' ylabel 'Intrinsic Gain' title 'NMOS gm/Id vs gm/gds'
  *plot $plot_fT vs $plot_gm_id xlabel 'Current Eff S/A' ylabel 'Transit Frequency GHz' title 'NMOS Id/W vs fT'
  *plot $plot_gm_id vs $plot_vov xlabel 'Overdrive Voltage V' ylabel 'Current Eff S/A' title 'NMOS gm/Id vs Vov'

  plot dc1.id_W_n vs dc1.gm_id_n dc2.id_W_n vs dc2.gm_id_n dc3.id_W_n vs dc3.gm_id_n xlabel 'Current Eff S/A' ylabel 'A/W' title 'PMOS_lvt Id/W vs gm/Id'
  plot dc1.gm_gmds_n vs dc1.gm_id_n dc2.gm_gmds_n vs dc2.gm_id_n dc3.gm_gmds_n vs dc3.gm_id_n xlabel 'Current Eff S/A' ylabel 'Intrinsic Gain' title 'PMOS_lvt gm/Id vs gm/gds'
  plot dc1.f_T_n vs dc1.gm_id_n dc2.f_T_n vs dc2.gm_id_n dc3.f_T_n vs dc3.gm_id_n xlabel 'Current Eff S/A' ylabel 'Transit Frequency GHz' title 'PMOS_lvt Id/W vs fT'
  plot dc1.gm_id_n vs dc1.v_ov_n dc2.gm_id_n vs dc2.v_ov_n dc3.gm_id_n vs dc3.v_ov_n xlabel 'Overdrive Voltage V' ylabel 'Current Eff S/A' title 'NMOS_lvt gm/Id vs Vov'
  plot dc1.gm_id_n dc2.gm_id_n dc3.gm_id_n xlabel 'Overdrive Voltage V' ylabel 'Current Eff S/A' title 'PMOS_lvt gm/Id vs Vsg'

  
.endc
.end"}
