C {simulator_commands.sym} -190 -280 0 0 {name=COMMANDS
simulator=xyce
only_toplevel=false 
value="VGND GND 0 0
.PARAM Vsource = 2.5

.tran 0.01u 5m
.step Vsource list 2.5 2.25 2.75 
.step TEMP list 27 -20 100

.OPTIONS MEASPRINT = STDOUT

.MEASURE TRAN INVERTERD1_D2_SS TRIG V(vi)=0 RISE = 3 
+TARG V(net10)=0 RISE = 3 

.MEASURE TRAN INVERTERD2_D1_SS TRIG V(net2)=0 RISE = 3 
+TARG V(net3)=0 RISE = 3

.result \{INVERTERD1_D2_SS\}
.result \{INVERTERD2_D1_SS\}

.print tran format=raw file=CLK_TB_SS.raw v(*) i(*)
 "}
