 plot v(V_Preamp) title 'AutoZero Output Gain:10'
 plot v(V_input) v(V_Preamp) title 'AutoZero Input:10uV Gain:10 Offset approx: 4.5uV (x100 less offset than non-azero op amp)'
 *noise v(V_out2) Vp dec 10 1 1MEG
.endc
.end"}
