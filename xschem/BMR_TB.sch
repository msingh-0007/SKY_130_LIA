C {gnd.sym} -2960 910 0 0 {name=l6 lab=GND}
C {ammeter.sym} -2890 530 0 0 {name=Vmeas savecurrent=true spice_ignore=0}
C {ammeter.sym} -3170 530 0 0 {name=Vmeas1 savecurrent=true spice_ignore=0}
C {code_shown.sym} -5087.5 -587.5 0 0 {name=s1 only_toplevel=false value="
.lib /foss/pdks/sky130A/libs.tech/combined/sky130.lib.spice tt_mm

***Centered at 40C and varies to a range of -20 to 100; with 20C being 1-standard dev***
.param TEMPGAUSS = agauss(40, 60, 3)

***Centered at 2.5V and varies to a range of 2V to 3V; with 0.16mV being 1-standard dev***
***param VOLTGAUSS = agauss(2.5, 0.5, 3)

*** Ideal Biasing resistor is 50k with 5% Gold Band Tolerance ***
***param RESGAUSS = agauss(50k, 833.33, 3) 

.param ptemp = 'TEMPGAUSS'
***param Vsource = 'VOLTGAUSS'
***param Id_res = 'RESGAUSS'


.options temp = \{ptemp\}

.csparam ctemp = \{ptemp\}
***csparam cvolt = \{Vsource\}
***csparam cres = \{Id_res\}

.control
 let T = 0
 let V = 0
 let R = 0
 
let i_count = 100

 let T_vec = vector(i_count)
 *** let V_vec = vector(i_count)
 let R_vec = vector(i_count)
 
 let IVEC_1 = vector(i_count)
 let IVEC_2 = vector(i_count) 

 ***let IVEC_MAX = vector(i_count)
 ***let IVEC_MIN = vector(i_count)

 let index = 0
 option seed = 9
 set wr_vecnames 
 dowhile index <= 100
   save all
   save @m.xm4.msky130_fd_pr__nfet_g5v0d10v5[id]
   
    ***tran 1u 2m
    dc V1 0 5 0.1
    write BMR_MC_TT_POLY_RES_285.raw
   
   set noprintscale
  
    meas dc I_1 FIND i(Vmeas) WHEN v(vdd) = 2.5 RISE = 1
    meas dc I_2 FIND i(Vmeas1) WHEN v(vdd) = 2.5 RISE = 1
   
    let IVEC_1[index] = 'I_1' 
    let IVEC_2[index] = 'I_2'

   ***meas tran I_MAX MAX i(Vmeas) FROM = 0.02m TO = 0.48m 
   ***meas tran I_MIN MIN i(Vmeas) FROM = 0.52m TO = 0.98m 
   
   ***let IVEC_MAX[index] = 'I_MAX' 
   ***let IVEC_MIN[index] = 'I_MIN'

   set appendwrite
   
   let T = $&ctemp
   let T_vec[index] = 'T'

   ***let V = $&cvolt
   ***let V_vec[index] = 'V'

   let Poly_V = 'v(net3)'
   let Poly_I = @m.xm4.msky130_fd_pr__nfet_g5v0d10v5[id]
   let R = 'Poly_V[25]/Poly_I[25]'
   let R_vec[index] = 'R'

   echo -n This is $&T Celcius
   echo -n This is $&R Ohms
   ***echo -n This is $&V Volts


   reset
   let index = index + 1
  end
 
  **OL AC
  *** print col GAIN_vec UGW_vec PM_vec T_vec V_vec > FDA_AC_CM_GAIN_UGW_PM_SS_PVT.txt
  **Offset   
  ***print col OFFSET_vec T_vec V_vec > FDA_OFFSETS_SS_PVT.txt
  **NOISE   
    print col IVEC_1 IVEC_2 T_vec R_vec > BMR_MONTE_CARLO_TT_POLY_RES_285.txt
  
.endc
.end"}
