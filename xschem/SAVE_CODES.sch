C {simulator_commands.sym} -1870 -2480 0 0 {name=COMMANDS_FFT
simulator=ngspice
only_toplevel=false 
value="
.lib /foss/pdks/sky130A/libs.tech/combined/sky130.lib.spice tt
.options method = trap
.options rshunt = 1e12
.options retol = 0.01
.options vntol = 10u
.options abstol = 1n
.options trtol = 10
.options chgtol = 1e-10

.options sparse
.control
 save all
 tran 1u 50m 0 100u
 
 let VIN_MIX = 'v(Voutp) - v(Voutm)'
 let VOUT_MIX = 'v(MIXOUTP)-v(MIXOUTM)'
 let DIFF_FFT = 'v(DIFFOUT)'
 let GMOUT_FFT = 'v(GMCOUT)'
 let OUT_FFT = 'v(VOUTPUT)'

 write Lock_In_Amplifier_TB_TT_NOISY_10UV_FFT_NGSPICE.raw
 ***write Lock_In_Amplifier_TB_TT_1MV_IDEAL_NGSPICE.raw

 setplot tran1
 linearize VIN_MIX
 set specwindow = hanning
 fft VIN_MIX
 write Lock_In_Amplifier_NOISY_OUTPUTS_10UV_FFT_NGSPICE.raw

 set appendwrite
 setplot tran1
 linearize VOUT_MIX
 set specwindow = hanning
 fft VOUT_MIX
 write Lock_In_Amplifier_NOISY_OUTPUTS_10UV_FFT_NGSPICE.raw


 set appendwrite
 setplot tran1
 linearize DIFF_FFT
 set specwindow = hanning
 fft DIFF_FFT
 write Lock_In_Amplifier_NOISY_OUTPUTS_10UV_FFT_NGSPICE.raw


 set appendwrite
 setplot tran1
 linearize GMOUT_FFT
 set specwindow = hanning
 fft GMOUT_FFT
 write Lock_In_Amplifier_NOISY_OUTPUTS_10UV_FFT_NGSPICE.raw


 set appendwrite
 setplot tran1
 linearize OUT_FFT
 set specwindow = hanning
 fft OUT_FFT
 write Lock_In_Amplifier_NOISY_OUTPUTS_10UV_FFT_NGSPICE.raw


 set appendwrite 
.endc
.end"}
