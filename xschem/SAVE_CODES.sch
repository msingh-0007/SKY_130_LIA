C {code_shown.sym} -1327.5 -3497.5 0 0 {name=OPNOISE only_toplevel=false value="
.lib /foss/pdks/sky130A/libs.tech/combined/sky130.lib.spice ff
.param ptemp = 27
.param Vsource = 2.5
.options temp = \{ptemp\}
.control
 let T = 0
 let V = 0
 set wr_vecnames
 *set wr_singlescale
 foreach tval -20 100 27
  foreach vval 2.25 2.75 2.5
   save all
   *tran 1u 2m
   *dc V1 0 6 0.01
   *ac dec 100 0.1 30MEG
   noise v(Vout) V1 dec 100 1 30MEG
   setplot previous
   write OP_AMP_TB_NOISE_FF_PVT.raw
   set appendwrite
   setplot next
   wrdata OP_AMP_TB_INOISE_TOTAL_FF_PVT.txt inoise_total
   wrdata OP_AMP_TB_ONOISE_TOTAL_FF_PVT.txt onoise_total
   *set appendwrite
   let V = $vval
   alterparam Vsource = $&V
   reset
  end
   let T = $tval
   alterparam ptemp = $&T
   reset
 end
.endc
.end"}
C {code_shown.sym} -1650 -2220 0 0 {name=sFDAORIG only_toplevel=false value="
.lib /foss/pdks/sky130A/libs.tech/combined/sky130.lib.spice tt
.control
 *foreach val -0.2m -0.4m -0.6m -0.8m
  save all
  tran 1n 21u 1u
  let V = 'v(Voutp) - v(Voutm)'
  linearize V
  set specwindow = blackman
  fft V
  *let Freq = fourier11[0]
  *let Mag = fourier11[1]
  *noise v(vout+, vout-) V2 dec 100 1 30MEG 
  *dc V2 -2.5 2.5 0.01
  *op
  write FDA_FFT.raw
  *let CM = $val
  *alterparam CM_VAL = $&CM
  set appendwrite
  reset
 *end
.endc
.end"}
C {code_shown.sym} 852.5 -2067.5 0 0 {name=FDA_MEAS only_toplevel=false value="
.lib /foss/pdks/sky130A/libs.tech/combined/sky130.lib.spice ff
.param ptemp = 27
.param Vsource = 2.5
.options temp = \{ptemp\}
.control
 let T = 0
 let V = 0
 set wr_vecnames
 *set wr_singlescale
 foreach tval -20 100 27
  foreach vval 2.25 2.75 2.5
   save all
   *tran 1u 2m
   *dc V1 0 6 0.01
   ac dec 100 0.1 30MEG
   *noise v(Vout) V1 dec 100 1 30MEG
   *setplot previous
   write FDA_TB_AC_DIFF_FF_PVT.raw
   set appendwrite
   **OL GAIN**
   let vdiff = 'v(voutp) + v(outm)'
   meas ac olgain FIND vdiff AT=1 
   let olgaindb = 'db(olgain)'
   wrdata FDA_OL_GAIN_DB_FF_PVT.txt olgaindb
   **UGW**
   meas ac ugw WHEN vdiff=0 FALL=1
   wrdata FDA_OL_UGW_FF_PVT.txt ugw
   **PM**
   let pm = '180 + 180/PI*ph(voutp)'
   meas ac ph FIND pm WHEN vdiff=0 FALL=1
   wrdata FDA_OL_PM_FF_PVT.txt pm
   *setplot next
   *wrdata OP_AMP_TB_ONOISE_TOTAL_SS_PVT.txt onoise_total
   *set appendwrite
   let V = $vval
   alterparam Vsource = $&V
   reset
  end
   let T = $tval
   alterparam ptemp = $&T
   reset
 end
.endc
.end"}
C {code_shown.sym} 1462.5 -2167.5 0 0 {name=FDAFF only_toplevel=false value="
.lib /foss/pdks/sky130A/libs.tech/combined/sky130.lib.spice ff
.param ptemp = 27
.param Vsource = 2.5
.options temp = \{ptemp\}
.control
 let T = 27
 let V = 2.5
 
 let i_count = 9
 let T_vec = vector(i_count)
 let V_vec = vector(i_count)
 let PM_vec = vector(i_count)
 let UGW_vec = vector(i_count)
 let GAIN_vec = vector(i_count)

 let index = 0
 
 set wr_vecnames
 foreach tval -20 100 27
  foreach vval 2.25 2.75 2.5
   save all
   *tran 1u 2m
   *dc V1 0 6 0.01
   ac dec 100 0.1 30MEG
   *noise v(Vout) V1 dec 100 1 30MEG
   *setplot previous
   write FDA_TB_AC_DIFF_FF_PVT.raw
   
   set noprintscale
   **OL GAIN**
   let vdiff = 'v(voutp) - v(voutm)'
   let olgaindb = 'db(vdiff)'
   meas ac olgain MAX olgaindb 
   let GAIN_vec[index] = 'olgain'
   **UGW**
   meas ac ugw WHEN olgaindb=0 FALL=1
   let UGW_vec[index] = 'ugw'
   **PM**
   let pm = '180 + 180/PI*ph(voutp)'
   meas ac ph FIND pm WHEN olgaindb=0 FALL=1
   let PM_vec[index] = 'ph'
   *setplot next
   *wrdata OP_AMP_TB_ONOISE_TOTAL_SS_PVT.txt onoise_total
   
   set appendwrite
   let V_vec[index] = 'V'
   let T_vec[index] = 'T'
   
   echo -n This is $&V
   echo -n This is $&T  

   let V = $vval
   alterparam Vsource = $&V
   reset
   let index = index + 1
  end
   let T = $tval
   alterparam ptemp = $&T
   reset
 end
   print col GAIN_vec UGW_vec PM_vec T_vec V_vec > FDA_AC_GAIN_UGW_PM_FF_PVT.txt
.endc
.end"}
