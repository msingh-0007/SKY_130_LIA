C {code_shown.sym} -2850 -2680 0 0 {name=s4 only_toplevel=false value="
.lib /foss/pdks/sky130A/libs.tech/combined/sky130.lib.spice tt
.control
  *plot deriv(i(Vmeas)) deriv(i(Vmeas1))
  *tran 1u 2m 
  let vcccp = 0
  let vcccm = 0
  *let vcm = -0.5        
  repeat 10                  
    alter V6 $&vcccp 
    alter V7 $&vcccm
    *alter V2 $&vcm        
    *ac dec 100 0.1 30MEG
    *dc V1 -2.5 2.5 0.01
    tran 1u 5m 
    *plot db(v(Voutb)/(v(Vin+))) xlog title 'Gain BW'
    plot v(Vin+) v(Voutb)
    *plot (180/PI)*phase(v(VoutB)/v(Vin+)) xlog title 'Phase BW'
    *plot deriv(i(Vmeas)) deriv(i(Vmeas1))
    let vcccp = vcccp + 0.025   ; calculate new voltage value for Vcc by updating vector vccc
    let vcccm = vcccm - 0.025   ; calculate new voltage value for Vcc by updating vector vccc
    *let vcm = vcm + 0.1   ; calculate new voltage value for Vcc by updating vector vccc
  end        
  *plot v(VoutA) v(Vin+)
  *plot v(VoutB) v(Vin+)
  *op
  *noise v(VoutB) V1 dec 100 0.1 30MEG
.endc
.end"}
C {simulator_commands.sym} -1360 -2510 0 0 {name=COMMANDS1
simulator=ngspice
only_toplevel=false 
value="
  VGND GND 0 0
  *plot db((v(Vout+)-v(Vout-))/(v(Vin+)-v(Vin-))) xlog title 'Gain OL'
  *plot (180/PI)*phase((v(Vout+)-v(Vout-))/(v(Vin+)-v(Vin-))) xlog title 'Phase OL'
  *plot db((v(Vout+) + v(Vout-))/(2*v(VCM))) xlog title 'Gain OL'
  *plot (180/PI)*phase((v(Vout+) + v(Vout-))/(2*v(VCM))) xlog title 'Phase OL'    
  .tran 1u 20m
  *noise v(Vout+ ,Vout-) V1 dec 100 0.1 1MEG
  .print tran format=raw file=Lock_In_Amplifier.raw v(*) i(*)"}
C {code_shown.sym} -17.5 -2187.5 0 0 {name=OP_AMP_PVT only_toplevel=false value="
.lib /foss/pdks/sky130A/libs.tech/combined/sky130.lib.spice tt
.param ptemp = 27
.param Vsource = 2.5
.options temp = \{ptemp\}
.control
 let T = 0
 let V = 0
 foreach tval -20 100 27
  foreach vval 2.25 2.75 2.5
   save all
   *tran 0.1u 8m
   *dc V1 0 6 0.01
   ac dec 100 0.1 30MEG
   write OP_AMP_TB_AC_TT_PVT.raw
   set appendwrite
   let V = $vval
   alterparam Vsource = $&V
   reset
  end
   let T = $tval
   alterparam ptemp = $&T
   reset
 end
.endc
.end"}
