C {code_shown.sym} -280 -250 0 0 {name=op_amp_3_test only_toplevel=false value="
.lib /foss/pdks/sky130A/libs.tech/combined/sky130.lib.spice tt
.control
  *dc V1 -2.5 2.5 0.01
  tran 1u 10m 
  *ac dec 100 0.1 30MEG
  *plot db(v(Vout)/(v(Vin+))) xlog title 'Gain BW'
  *plot (180/PI)*phase(v(Vout)/v(Vin+)) xlog title 'Phase BW'
  plot v(Vout)
  plot v(Vin+)
  *op
  *noise v(Vout) V1 dec 100 0.1 1MEG
.endc
.end"}
