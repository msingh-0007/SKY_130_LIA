C {code_shown.sym} -5640 -1195 0 0 {name=s5 only_toplevel=false value="
.lib /foss/pdks/sky130A/libs.tech/combined/sky130.lib.spice tt
.param ptemp = 27
.param Vsource = 2.5
.options temp = \{ptemp\}
.control
 let T = 27
 let V = 2.5
 
 let i_count = 9
 let T_vec = vector(i_count)
 let V_vec = vector(i_count)
 *let PM_vec = vector(i_count)
 *let UGW_vec = vector(i_count)
 *let GAIN_vec = vector(i_count)
 let OFFSET_vec = vector(i_count)

 let index = 0
 
 set wr_vecnames
 foreach tval -20 100 27
  foreach vval 2.25 2.75 2.5
   save all
   tran 1u 2m
   *dc V1 0 6 0.01
   *ac dec 100 0.1 30MEG
   *noise v(Vout) V1 dec 100 1 30MEG
   *setplot previous
   write FDA_TRAN_OFFSETS_TT_PVT.raw
   
   set noprintscale
   **OL GAIN**
   let vdiff = 'v(voutp) - v(voutm)'
   ***let vcom = '(v(voutp) + v(voutm))/2'
   ***let olgaindb = 'db(vcom)'
   ***meas ac olgain MAX olgaindb 
   ***let GAIN_vec[index] = 'olgain'
   **UGW**
   ***meas ac ugw WHEN olgaindb=0 FALL=1
   ***let UGW_vec[index] = 'ugw'
   **PM**
   ***let pm = '180 + 180/PI*ph(voutp)'
   ***let pm_cm = '180/PI*ph(voutp)'
   ***meas ac ph FIND pm_cm WHEN olgaindb=0 FALL=1
   ***let PM_vec[index] = 'ph'
   *setplot next
   *wrdata OP_AMP_TB_ONOISE_TOTAL_SS_PVT.txt onoise_total
   **OFFSET**
   let vidiff = 'v(vinp) - v(vinm)'
   let voff = 'vdiff - vidiff'
   meas tran offsets MAX voff
   let OFFSET_vec[index] = 'offsets' 
   
   set appendwrite
   let V_vec[index] = 'V'
   let T_vec[index] = 'T'
   
   echo -n This is $&V
   echo -n This is $&T  

   let V = $vval
   alterparam Vsource = $&V
   reset
   let index = index + 1
  end
   let T = $tval
   alterparam ptemp = $&T
   reset
 end
  **OL AC
  ** print col GAIN_vec UGW_vec PM_vec T_vec V_vec > FDA_AC_CM_GAIN_UGW_PM_SS_PVT.txt
  **Offset   
     print col OFFSET_vec T_vec V_vec > FDA_OFFSETS_TT_PVT.txt
  

.endc
.end"}
