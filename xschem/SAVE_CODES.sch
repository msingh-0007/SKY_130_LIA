C {code_shown.sym} 10 -760 0 0 {name=FDA only_toplevel=false value="
.param C_VAL = 0.5p
.lib /foss/pdks/sky130A/libs.tech/combined/sky130.lib.spice tt
.control
 foreach val 1p 1.5p 2p 2p
  save all
  *set nfreqs = 10
  *tran 1u 5m 1m
  *fourier 1k v(vout)
  ac dec 100 0.1 50MEG
  plot db((v(Vout+)- V(Vout-))/(v(Vin+))) xlog title 'Gain BW'
  plot (180/PI)*phase((v(Vout+)- V(Vout-))/v(Vin+)) xlog title 'Phase BW'
  plot (180/PI)*phase((v(Vout+)- V(Vout-))) xlog title 'Phase BW_T'
  let C = $val
  alterparam C_VAL = $&C
  write FDA_TB_AC.raw
  set appendwrite
  reset
 end
.endc
.end"}
C {code_shown.sym} -1790 -1490 0 0 {name=s3 only_toplevel=false value="
* gm/ID Characterization for Sky130 nfet_01v8
* Parameters
.lib /foss/pdks/sky130A/libs.tech/combined/sky130.lib.spice ss
.param setup = 0

.control
   
  * Direct Plotting in ngspice
 set xbrushwidth=2
 let s_val =2.1n
 set plot_set_up = ' '
 set plot_clk = ' '
 repeat 20
  alterparam setup = $&s_val
  reset
  tran 1p 3n
  let vq = 'v(Q)'
  let vclk = 'v(Vin)'
  set plot_set_up = ( $plot_set_up \{$curplot\}.vq )
  set plot_clk = ( $plot_clk \{$curplot\}.vclk )

  let s_val = s_val - 10p
 end
  set nolegend 
  plot $plot_set_up title 'Setup Time'
  plot $plot_clk v(clk_in) title 'Input and clk'
  
.endc
.end"}
