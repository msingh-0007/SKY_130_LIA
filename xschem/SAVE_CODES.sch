C {simulator_commands.sym} -4230 -910 0 0 {name=COMMANDS
simulator=xyce
only_toplevel=false 
value="VGND GND 0 0
.PARAM Vsource = 2.5

.tran 0.1u 5m
.step Vsource list 2.5 2.25 2.75 
.step TEMP list 27 -20 100

.OPTIONS MEASPRINT = STDOUT

.MEASURE TRAN CLK_SLEW_RISE_SS TRIG V(vclk1)=\{-0.9*Vsource\} RISE = LAST 
+TARG V(vclk1)=\{0.9*Vsource\} RISE = LAST 

.MEASURE TRAN CLK_SLEW_FALL_SS TRIG V(vclk1)=\{0.9*Vsource\} FALL = LAST 
+TARG V(vclk1)=\{-0.9*Vsource\} FALL = LAST 

.result \{CLK_SLEW_RISE_SS\}
.result \{CLK_SLEW_FALL_SS\}

.print tran format=raw file=CLK_TB_SS.raw v(*) i(*)
 "}
C {simulator_commands.sym} -4240 -700 0 0 {name=COMMANDS2
simulator=xyce
only_toplevel=false 
value="VGND GND 0 0
.PARAM Vsource = 2.5

.tran 0.01u 5m
.step Vsource list 2.5 2.25 2.75 
.step TEMP list 27 -20 100

.OPTIONS MEASPRINT = STDOUT

.MEASURE TRAN CLK_SKEW_RISE_SS TRIG V(vclk1)=0 RISE = LAST 
+TARG V(vclk2)=0 RISE = LAST 

.MEASURE TRAN CLK_SKEW_FALL_SS TRIG V(vclk1)=0 FALL = LAST 
+TARG V(vclk2)=0 FALL = LAST 

.result \{CLK_SKEW_RISE_SS\}
.result \{CLK_SKEW_FALL_SS\}

.print tran format=raw file=CLK_TB_SS.raw v(*) i(*)
 "}
C {code_shown.sym} -3860 -3040 0 0 {name=s6 only_toplevel=false value="
.lib /foss/pdks/sky130A/libs.tech/combined/sky130.lib.spice tt
.param ptemp = 27
.param Vsource = 2.5
.options temp = \{ptemp\}
.control
 let T = 27
 let V = 2.5
 
 let i_count = 9
 let T_vec = vector(i_count)
 let V_vec = vector(i_count)
 *let CUTOFF_vec = vector(i_count)
 let OFFSET_vec = vector(i_count)
 *let INOISE_total_vec = vector(i_count)
 *let ONOISE_total_vec = vector(i_count)

 let index = 0
 
 set wr_vecnames
 foreach tval -20 100 27
  foreach vval 2.25 2.75 2.5
   save all
   *tran 1u 20m
   dc V1 -2.5 2.5 0.1
   *ac dec 100 0.1 30MEG
   *noise v(Voutb) V1 dec 100 1 2.5MEG
   *setplot previous
   write GMC_REDO_05_OFFSET_TT_PVT.raw
   
   set noprintscale
   **OL GAIN**
    ***let gaindb = 'db(voutb/vin)'
    ***meas ac maxgain MAX gaindb 
    ***let cutoffdb = 'maxgain - 3'
    ***meas ac cutoff_freq WHEN gaindb = cutoffdb
    ***let CUTOFF_vec[index] = 'cutoff_freq' 
   **UGW**
   ***meas ac ugw WHEN olgaindb=0 FALL=1
   ***let UGW_vec[index] = 'ugw'
   **PM**
   ***let pm = '180 + 180/PI*ph(voutp)'
   ***let pm_cm = '180/PI*ph(voutp)'
   ***meas ac ph FIND pm_cm WHEN olgaindb=0 FALL=1
   ***let PM_vec[index] = 'ph'
   ***setplot next
   ***wrdata GMC_TB_ONOISE_TOTAL_TT_PVT.txt onoise_total
   **OFFSET**
   ***let vidiff = 'v(vinp) - v(vinm)'
   ***let voff = 'vdiff - vidiff'
    meas dc offsets FIND v(voutb) WHEN v(vin) = 0 RISE = 1
    let OFFSET_vec[index] = 'offsets' 
   **NOISE**
   ***setplot next
   ***let inoise = 'inoise_total'
   ***let onoise = 'onoise_total'
   
   ***let INOISE_total_vec[index] = 'inoise'
   ***let ONOISE_total_vec[index] = 'onoise'
  
  

   set appendwrite
   let V_vec[index] = 'V'
   let T_vec[index] = 'T'
   
   echo -n This is $&V
   echo -n This is $&T  

   let V = $vval
   alterparam Vsource = $&V
   reset
   let index = index + 1
  end
   let T = $tval
   alterparam ptemp = $&T
   reset
 end
  **OL AC
   ***print col CUTOFF_vec T_vec V_vec > GM_REDO_AC_06_CUTOFF_SS_PVT.txt
  **Offset   
    ***print col OFFSET_vec T_vec V_vec > GMC_REDO_OFFSETS_05_TT_PVT.txt
  **NOISE   
  ***print col INOISE_total_vec ONOISE_total_vec T_vec V_vec > GMC_NOISE05_TT_PVT.txt
  

.endc
.end"}
C {code_shown.sym} -4737.5 2.5 0 0 {name=s7 only_toplevel=false value="
.lib /foss/pdks/sky130A/libs.tech/combined/sky130.lib.spice ss_mm

***Centered at 40C and varies to a range of -20 to 100; with 20C being 1-standard dev***
.param TEMPGAUSS = agauss(40, 60, 3)

***Centered at 2.5V and varies to a range of 2V to 3V; with 0.16mV being 1-standard dev***
.param VOLTGAUSS = agauss(2.5, 0.5, 3)

.param ptemp = 'TEMPGAUSS'

.param Vsource = 'VOLTGAUSS'
.options temp = \{ptemp\}

.csparam ctemp = \{ptemp\}
.csparam cvolt = \{Vsource\}


.control
 let T = 27
 let V = 2.5
 
 let i_count = 100
 let T_vec = vector(i_count)
 let V_vec = vector(i_count)
 
 let OFFSETP_vec = vector(i_count)
 let OFFSETM_vec = vector(i_count)
 let OFFSETCM_vec = vector(i_count)
 let OFFSETDIF_vec = vector(i_count)
 let OFFSETMIX_vec = vector(i_count)
 let OFFSETOUT_vec = vector(i_count)

 let index = 0
 
 set wr_vecnames
 dowhile index <= 100
   save all
   tran 1u 2m
   *dc V1 0 6 0.01
   *ac dec 100 0.1 30MEG
  
   write PRE_LPF_OFFSETS_SS_MM_PVT.raw
   
   set noprintscale
   
   **OFFSET**

 
    let vodiff = 'v(voutp) - v(voutm)'
    let vmixdiff = 'v(MIXOUTP) - v(MIXOUTM)'
    ***let voff = 'vdiff - vidiff'
   
   meas tran Offp AVG v(voutp) FROM= 1m TO = 2m
   meas tran Offm AVG v(voutm) FROM= 1m TO = 2m
   meas tran Offdif AVG vodiff FROM= 1m TO = 2m
   meas tran Offmix AVG vmixdiff FROM= 1m TO = 2m
   meas tran Offout AVG v(DIFFOUT) FROM= 1m TO = 2m
    
   let OFFSETP_vec[index] = 'Offp' 
   let OFFSETM_vec[index] = 'Offm' 
   let OFFSETCM_vec[index] = '(Offp + Offm)/2' 
   let OFFSETDIF_vec[index] = 'Offdif'
   let OFFSETMIX_vec[index] = 'Offmix'
   let OFFSETOUT_vec[index] = 'Offout'
   

   set appendwrite  
     

   let V = $&cvolt
   let T = $&ctemp

   echo -n This is $&V
   echo -n This is $&T
   echo -n This is $&index

   let V_vec[index] = 'V'
   let T_vec[index] = 'T'
   
   let index = index + 1
   reset
 end
  **OL AC
  *** print col GAIN_vec UGW_vec PM_vec T_vec V_vec > FDA_AC_CM_GAIN_UGW_PM_SS_PVT.txt
  **Offset   
   print col OFFSETDIF_vec OFFSETMIX_vec OFFSETOUT_vec T_vec V_vec > PRE_LPF_OFFSETS_SS_MM_PVT.txt
    
.endc
.end"}
